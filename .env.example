# Application port exposed on the host machine
APP_PORT=8080

# SQL Server port exposed on the host machine
SQLSERVER_PORT=1433

# ASP.NET Core environment
ASPNETCORE_ENVIRONMENT=Production

# SQL Server administrator password
# Must contain uppercase, lowercase, number, and special character
SQLSERVER_SA_PASSWORD=ChangeThis_StrongPassword_123!

# JWT signing key
# Use a long random value with at least 64 characters
JWT_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_KEY_AT_LEAST_64_CHARACTERS

JWT_ISSUER=CorporateChat
JWT_AUDIENCE=CorporateChatUsers
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Frontend origin allowed to call the API
CORS_ORIGIN_0=http://localhost:8080

# Persistent upload path inside the container
UPLOAD_PATH=/app/data/uploads

MAX_FILE_SIZE_MB=50
